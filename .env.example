# Create a copy named .env and replace the values for your provider.
AI_ADVENT_API_KEY=sk-your-api-key

# Any OpenAI-compatible provider can be used by changing model and base URL.
AI_ADVENT_MODEL=gpt-5.6-luna
AI_ADVENT_BASE_URL=https://api.openai.com/v1
AI_ADVENT_EMBEDDING_MODEL=text-embedding-3-small

# Local Ollama embeddings can be used with:
# ai-advent index build ... --embedding-provider ollama
AI_ADVENT_OLLAMA_BASE_URL=http://localhost:11434

# Agent messages are persisted here between CLI restarts.
AI_ADVENT_MEMORY_FILE=.ai-advent/agent-memory.json
